<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GenshinSwitcherXamlPrototype.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F6F7F9" RequestedTheme="Light">
        <Border Width="520"
                Padding="28"
                CornerRadius="16"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <TextBlock Text="WinUI 3 启动测试"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#1F2328" />
                <TextBlock Text="C++ · Windows App SDK 1.7 · 未打包 · 框架依赖"
                           FontSize="13"
                           Foreground="#656D76" />
                <TextBlock Text="如果你能看到这个窗口，说明 WinUI 3 的标准 XAML 启动链路可以在这台电脑上工作。"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="#1F2328"
                           Margin="0,8,0,4" />
                <Button x:Name="TestButton"
                        Content="点击测试"
                        Width="120"
                        HorizontalAlignment="Left"
                        Background="#0969DA"
                        Foreground="White"
                        Click="OnTestClick" />
                <TextBlock x:Name="StatusText"
                           Text="等待点击"
                           FontSize="13"
                           Foreground="#656D76" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
