<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GenshinAccountSwitcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Activated="OnWindowActivated">

    <Border x:Name="RootGrid"
            RequestedTheme="Dark"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,2,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="原神账号切换器" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="国服 · 本地账号管理" FontSize="12" Opacity="0.62" />
                </StackPanel>

                <Button x:Name="MoreButton"
                        Grid.Column="1"
                        Content="⋯"
                        Width="38"
                        Height="34"
                        Padding="0"
                        FontSize="18"
                        VerticalAlignment="Center"
                        CornerRadius="4">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="刷新状态" Click="OnRefreshClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="UpdateMenuItem" Text="更新所选账号登录态" Click="OnUpdateClick" />
                            <MenuFlyoutItem x:Name="RenameMenuItem" Text="重命名所选账号" Click="OnRenameClick" />
                            <MenuFlyoutItem x:Name="DeleteMenuItem" Text="删除所选账号" Click="OnDeleteClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="指定原神路径" Click="OnSelectGamePathClick" />
                            <MenuFlyoutItem x:Name="RestoreMenuItem" Text="恢复上一次切换前状态" Click="OnRestoreClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="打开数据目录" Click="OnOpenDataDirectoryClick" />
                            <MenuFlyoutItem Text="查看日志" Click="OnOpenLogClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Background="#2B2B2B"
                    BorderBrush="#3B3B3B"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="5">
                        <TextBlock Text="当前账号" FontSize="12" Opacity="0.60" />
                        <TextBlock x:Name="CurrentAccountText" Text="正在读取…" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentUidText" Text="UID —" FontSize="13" Opacity="0.72" />
                        <TextBlock x:Name="CredentialStateText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="#F2C94C"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button x:Name="AddButton"
                            Grid.Column="1"
                            Content="添加当前账号"
                            VerticalAlignment="Center"
                            CornerRadius="4"
                            Click="OnAddClick" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" MinHeight="230">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="2,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="已保存账号" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               x:Name="AccountCountText"
                               Text="0 个"
                               FontSize="12"
                               Opacity="0.60"
                               VerticalAlignment="Center" />
                </Grid>

                <ListView x:Name="AccountsList"
                          Grid.Row="1"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          HorizontalContentAlignment="Stretch"
                          MaxHeight="300"
                          SelectionChanged="OnAccountSelectionChanged">
                    <ListView.Resources>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          HorizontalContentAlignment="Stretch" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.Resources>
                </ListView>
            </Grid>

            <Grid Grid.Row="3" Margin="0,16,0,10" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SwitchButton"
                        Content="切换账号"
                        HorizontalAlignment="Stretch"
                        CornerRadius="4"
                        Click="OnSwitchClick" />
                <Button x:Name="SwitchLaunchButton"
                        Grid.Column="1"
                        Content="切换并启动原神"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        CornerRadius="4"
                        Click="OnSwitchLaunchClick" />
            </Grid>

            <TextBlock Grid.Row="4"
                       x:Name="StatusText"
                       Text=""
                       MinHeight="18"
                       FontSize="12"
                       Opacity="0.68"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</Window>
