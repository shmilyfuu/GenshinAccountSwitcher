<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GenshinAccountSwitcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Activated="OnWindowActivated">

    <Border x:Name="RootGrid"
            RequestedTheme="Dark"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock Text="原神账号切换器"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="国服 · 本地账号管理"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.62" />
                </StackPanel>

                <Button x:Name="MoreButton"
                        Grid.Column="1"
                        Content="⋯"
                        Width="36"
                        Height="32"
                        Padding="0"
                        FontSize="18"
                        VerticalAlignment="Center">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="刷新状态" Click="OnRefreshClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="UpdateMenuItem" Text="更新所选账号登录态" Click="OnUpdateClick" />
                            <MenuFlyoutItem x:Name="RenameMenuItem" Text="重命名所选账号" Click="OnRenameClick" />
                            <MenuFlyoutItem x:Name="DeleteMenuItem" Text="删除所选账号" Click="OnDeleteClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="指定原神路径" Click="OnSelectGamePathClick" />
                            <MenuFlyoutItem x:Name="RestoreMenuItem" Text="恢复上一次切换前状态" Click="OnRestoreClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="打开数据目录" Click="OnOpenDataDirectoryClick" />
                            <MenuFlyoutItem Text="查看日志" Click="OnOpenLogClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12">
                <TextBlock Text="当前账号"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="16,12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock x:Name="CurrentAccountText"
                                       Text="正在读取…"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="CurrentUidText"
                                       Text="UID —"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.72" />
                            <TextBlock x:Name="CredentialStateText"
                                       Text=""
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <Button x:Name="AddButton"
                                Grid.Column="1"
                                Content="添加当前账号"
                                VerticalAlignment="Center"
                                Click="OnAddClick" />
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" MinHeight="210">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="已保存账号"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1"
                               x:Name="AccountCountText"
                               Text="0 个"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.60"
                               VerticalAlignment="Center" />
                </Grid>

                <ListView x:Name="AccountsList"
                          Grid.Row="1"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          HorizontalContentAlignment="Stretch"
                          MaxHeight="260"
                          SelectionChanged="OnAccountSelectionChanged" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,12,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SwitchButton"
                        Content="切换账号"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="OnSwitchClick" />
                <Button x:Name="SwitchLaunchButton"
                        Grid.Column="1"
                        Content="启动"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="OnSwitchLaunchClick" />
            </Grid>

            <TextBlock Grid.Row="4"
                       x:Name="StatusText"
                       Text=""
                       Margin="0,8,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.68"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
